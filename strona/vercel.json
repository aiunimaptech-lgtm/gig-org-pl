{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/wpis/:slug+/",
      "destination": "/wpis/index.html"
    },
    {
      "source": "/wpis/:slug+",
      "destination": "/wpis/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.gig.org.pl"
        }
      ],
      "destination": "https://gig.org.pl/$1",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/o-nas/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/baza-wiedzy/aktualnosci-gig/",
      "permanent": true
    },
    {
      "source": "/category/aktualnosci/",
      "destination": "/baza-wiedzy/aktualnosci-gig/",
      "permanent": true
    },
    {
      "source": "/category/artykuly/",
      "destination": "/baza-wiedzy/artykuly/",
      "permanent": true
    },
    {
      "source": "/przyklad/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    },
    {
      "source": "/(admin|glosowanie|ankieta|uczestnicy|wizytowka|wypis)(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/wp-content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/wp-includes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/_assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/_assets/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
